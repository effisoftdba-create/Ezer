{
  "$schema": "https://react.doctor/schema.json",
  "rules": {
    "no-giant-component": 0,
    "react-doctor/no-giant-component": 0,
    "prefer-useReducer": 0,
    "react-doctor/prefer-useReducer": 0,
    "no-static-element-interactions": 0,
    "react-doctor/no-static-element-interactions": 0,
    "control-has-associated-label": 0,
    "react-doctor/control-has-associated-label": 0,
    "no-array-index-as-key": 0,
    "react-doctor/no-array-index-as-key": 0,
    "no-placeholder-only-field": 0,
    "react-doctor/no-placeholder-only-field": 0,
    "dangerous-html-sink": 0,
    "react-doctor/dangerous-html-sink": 0,
    "no-adjust-state-on-prop-change": 0,
    "react-doctor/no-adjust-state-on-prop-change": 0,
    "no-derived-state": 0,
    "react-doctor/no-derived-state": 0,
    "html-no-nested-interactive": 0,
